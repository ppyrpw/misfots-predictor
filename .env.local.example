# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── API-Football (api-sports.io) ────────────────────────────────────────────
# Get a free key at: https://dashboard.api-football.com/register
# Free tier: 100 calls/day — more than enough for polling every 30min on match days
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

# ─── App ─────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens (generate any long random string)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Prediction lock time (ISO 8601 in UTC — 1pm Central = 18:00 UTC on June 11)
NEXT_PUBLIC_DEADLINE=2026-06-11T18:00:00.000Z
